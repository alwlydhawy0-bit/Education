# Copy to .env for local development. NEVER commit a real .env.
#
# The API refuses to start if a security-relevant value is missing or unsafe;
# see apps/api/src/platform/config.ts. In particular, in production it will not
# start with insecure cookies, a plaintext allowed origin, or rate limiting off.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# The APPLICATION role — non-superuser, NOBYPASSRLS. Never the migrator, and
# never a superuser: RLS would be bypassed entirely.
DATABASE_URL=postgres://edu_app:CHANGE_ME@127.0.0.1:5432/edu_dev
DATABASE_POOL_MAX=10

# Exact origins allowed to make state-changing requests (comma-separated).
# Must all be https:// in production.
ALLOWED_ORIGINS=http://localhost:5173

SESSION_COOKIE_NAME=edu_session
SESSION_TTL_HOURS=12
# Must be true in production. Only set false for local plaintext development.
SESSION_COOKIE_SECURE=false

RATE_LIMIT_ENABLED=true

# --- Migrations only (not read by the running server) ---------------------
# Used by `pnpm db:migrate`. Owns the schema; must NOT be a superuser.
# MIGRATION_DATABASE_URL=postgres://edu_migrator:CHANGE_ME@127.0.0.1:5432/edu_dev
