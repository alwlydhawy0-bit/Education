# Copy to .env for local development. NEVER commit a real .env.
#
# The API refuses to start if a security-relevant value is missing or unsafe;
# see apps/api/src/platform/config.ts. In particular, in production it will not
# start with insecure cookies, a plaintext allowed origin, or rate limiting off.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# The APPLICATION role — non-superuser, NOBYPASSRLS. Never the migrator, and
# never a superuser: RLS would be bypassed entirely.
DATABASE_URL=postgres://edu_app:CHANGE_ME@127.0.0.1:5432/edu_dev
DATABASE_POOL_MAX=10

# Exact origins allowed to make state-changing requests (comma-separated).
# Must all be https:// in production.
ALLOWED_ORIGINS=http://localhost:5173

SESSION_COOKIE_NAME=edu_session
SESSION_TTL_HOURS=12
# Must be true in production. Only set false for local plaintext development.
SESSION_COOKIE_SECURE=false

RATE_LIMIT_ENABLED=true

# --- Learning assistant (Task 013) ----------------------------------------
# SERVER-SIDE ONLY. There is deliberately no VITE_ equivalent of any of these:
# VITE_ is the only prefix Vite inlines into the browser bundle, so a key behind
# one would be shipped to every browser that loads the page. The browser talks
# only to POST /api/v1/assistant/ask on the same origin; the API holds the
# credential.
#
# `none` is a REAL mode, not a disabled one: the assistant runs on a
# deterministic offline composer that quotes retrieved passages and cites
# exactly what it quoted. Authorization, retrieval, citation validation, refusal
# and quota all run. A missing key costs fluency, never safety.
AI_PROVIDER=none
# AI_API_KEY is secret-bearing (see SECRET_BEARING_KEYS in config.ts) and is
# redacted from logs and from the configuration summary. Unset while
# AI_PROVIDER=none.
# AI_API_KEY=CHANGE_ME
AI_TIMEOUT_MS=15000

# --- Migrations only (not read by the running server) ---------------------
# `pnpm db:migrate` reads DATABASE_URL, NOT this variable — so run it with the
# migrator URL supplied inline, and leave DATABASE_URL above pointing at the
# APPLICATION role:
#
#   DATABASE_URL="postgres://edu_migrator:PASSWORD@127.0.0.1:5432/edu_dev" pnpm db:migrate
#
# This records the migrator URL for reference; no tooling reads it. Migrating as
# edu_app fails outright; running the SERVER as edu_migrator would silently
# disable Row-Level Security, which is far worse than failing.
# MIGRATION_DATABASE_URL=postgres://edu_migrator:CHANGE_ME@127.0.0.1:5432/edu_dev
