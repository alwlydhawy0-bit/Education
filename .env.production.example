# =============================================================================
# .env.production — TEMPLATE. Copy, fill in, and NEVER commit the filled copy.
# =============================================================================
#
# Validate before deploying, from a laptop or a pipeline step:
#
#   node --experimental-strip-types tools/deploy/check-env.ts .env.production
#
# That runs the SAME schema the server enforces at startup (apps/api/src/
# platform/config.ts), so a problem surfaces before an image is built rather
# than as a crash loop at 03:00. It never prints a value.
#
# Every value below is SERVER-ONLY. There is deliberately no VITE_ counterpart
# to any of them: VITE_ is the prefix Vite inlines into the browser bundle, and
# a secret behind one is shipped to every browser that loads the page.
# -----------------------------------------------------------------------------

NODE_ENV=production

# 0.0.0.0 inside a container: the port is published by the orchestrator, and
# binding to loopback would make the service unreachable from outside the
# container while looking perfectly healthy inside it.
HOST=0.0.0.0
PORT=3000

# `debug` is REFUSED in production. Debug logging multiplies the volume of
# request-shaped detail written to disk, and with it the chance that something
# private is retained far longer than intended.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database — the APPLICATION role. NOT the migrator, NEVER a superuser.
# -----------------------------------------------------------------------------
# edu_app is NOBYPASSRLS and non-owner. Running the server as edu_migrator would
# silently disable Row-Level Security across the whole schema — the platform's
# entire second gate — with no error and no visible symptom.
#
# Migrations are run separately, with the migrator URL supplied inline:
#   DATABASE_URL="postgres://edu_migrator:...@host/db" pnpm db:migrate (secret-scan-allow: "..." is an elision, not a password)
DATABASE_URL=postgres://edu_app:CHANGE_ME@db.internal:5432/edu_production # secret-scan-allow: CHANGE_ME is the placeholder this template's own validator refuses to deploy

# Sized against the database's max_connections divided by the replica count,
# not against hope. Every replica opens up to this many.
DATABASE_POOL_MAX=20

# -----------------------------------------------------------------------------
# Shared rate-limit store — REQUIRED in production and staging.
# -----------------------------------------------------------------------------
# Without it, limits are counted per process: with six replicas a "10 logins per
# 15 minutes" limit enforces sixty, and nothing says so (RISK-RATE-01). The
# server refuses to start without this value.
#
# Treated as secret-bearing: a Redis URL routinely carries a password.
REDIS_URL=rediss://default:CHANGE_ME@cache.internal:6379 # secret-scan-allow: CHANGE_ME is the placeholder this template's own validator refuses to deploy

# -----------------------------------------------------------------------------
# Origins and proxy topology — the two settings that decide what a request IS.
# -----------------------------------------------------------------------------
# Exact origins permitted to make state-changing requests. All must be https://
# in production; the server refuses to start otherwise.
ALLOWED_ORIGINS=https://app.example.edu

# How request.ip is derived behind a load balancer, and therefore what every
# per-IP rate limit and every audit-trail address MEANS.
#
# Unset or `false` = trust nothing, correct for direct exposure.
# An address or CIDR list = believe the forwarding header only when the
# immediate peer is one of these.
#
# `true` is REFUSED: blanket trust believes a client-supplied X-Forwarded-For,
# so any caller picks their own rate-limit bucket and their own audit identity.
# A HOP COUNT is also refused — Fastify 5 compiles a numeric setting to a
# function that trusts no peer at all, so it would boot reporting proxy trust
# while keying every request to the load balancer.
# TRUST_PROXY=10.0.0.0/8

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=edu_session
REFRESH_COOKIE_NAME=edu_refresh
# Must be true in production; the server refuses to start otherwise.
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
REFRESH_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30
MAX_FAILED_LOGINS=10
LOCKOUT_MINUTES=15

# Leave false until mail delivery is actually configured. Turning it on without
# a working mail provider locks every user out permanently — a worse failure
# than the risk it addresses.
REQUIRE_VERIFIED_EMAIL_FOR_LOGIN=false

# Cannot be false in production; the server refuses to start.
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Learning assistant
# -----------------------------------------------------------------------------
# `none` is a REAL mode, not a disabled one: the assistant answers from
# retrieved course material through a deterministic offline composer, and every
# control — authorization, retrieval, citation validation, refusal, quota —
# still runs. A missing key costs fluency, never safety.
AI_PROVIDER=none
# REQUIRED the moment AI_PROVIDER is not `none`; naming a provider without a
# credential is a startup failure rather than a failure on a child's first
# question.
# AI_API_KEY=CHANGE_ME
AI_MODEL=claude-opus-5
AI_MAX_OUTPUT_TOKENS=2048
# Pinned deliberately: the vendor SDK otherwise defaults this to an ambient
# ANTHROPIC_BASE_URL, which would let the environment decide where the
# platform's credential and a child's coursework are sent (VULN-038).
AI_BASE_URL=https://api.anthropic.com
AI_TIMEOUT_MS=15000
