{
  "name": "@edu/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:watch": "vitest",
    "db:migrate": "node --experimental-strip-types db/migrate.ts",
    "db:reset": "node --experimental-strip-types db/migrate.ts --reset",
    "security:audit": "pnpm audit --audit-level=high",
    "security:secrets": "node --experimental-strip-types tools/security/scan-secrets.ts",
    "security:deps": "node --experimental-strip-types tools/security/check-deps.ts",
    "verify": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@edu/api": "workspace:*",
    "@edu/authz": "workspace:*",
    "@edu/contracts": "workspace:*",
    "@edu/kernel": "workspace:*",
    "@edu/observability": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zod": "^3.24.1",
    "fastify": "^5.2.0"
  }
}
