node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Secrets — never commit real environment files.
.env
.env.*
!.env.example
# The production TEMPLATE is tracked deliberately. It holds no secret — it fails
# its own validator until the placeholders are replaced — and being tracked is
# what puts it in the secret scanner's scope, which is where a template that
# grows a real password should be caught.
!.env.production.example
*.pem
*.key
!**/testdata/**/*.key

.DS_Store
.vscode/
.idea/
*.log
.vitest/
.eslintcache

# Evaluation benchmark output. Regenerated by `vitest --project evaluation`;
# the durable record of a run lives in docs/security/ai-evaluation.md.
tools/eval/reports/
